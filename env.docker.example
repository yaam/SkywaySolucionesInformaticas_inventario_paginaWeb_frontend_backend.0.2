# ========================================
# CONFIGURACIÓN DE DOCKER - SKYWAY SOLUCIONES INFORMÁTICAS
# ========================================
# Copia este archivo como .env y configura tus valores

# ========================================
# MONGODB
# ========================================
# Opción 1: Usar MongoDB Atlas (RECOMENDADO)
# Copia tu connection string de MongoDB Atlas
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/inventarios?retryWrites=true&w=majority

# Opción 2: Usar MongoDB Local con Docker (deja MONGO_URI vacío o comentado)
# MONGO_ROOT_PASSWORD es obligatoria: docker compose no arranca sin ella
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=tu_password_seguro_aqui
# MONGO_URI=mongodb://admin:tu_password_seguro_aqui@mongodb:27017/inventarios?authSource=admin

# ========================================
# BACKEND
# ========================================
PORT=4001

# Acceso de administrador (login del panel). Usa una contraseña larga y única.
ADMIN_USER=admin
ADMIN_PASSWORD=cambia_esta_contraseña
# Mínimo 32 caracteres aleatorios: openssl rand -hex 32
JWT_SECRET=
# Orígenes permitidos por CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost

# ========================================
# CONFIGURACIÓN DE EMAIL - ver CONFIGURACION_EMAIL_BREVO.md
# Define UNA: BREVO_API_KEY (prioritaria) o SENDGRID_API_KEY
# ========================================
BREVO_API_KEY=xkeysib-tu_api_key
SENDGRID_API_KEY=
# Remitente: debe estar verificado en el proveedor (Brevo: Senders / SendGrid: Sender Authentication)
EMAIL_FROM=tu_email_verificado@outlook.com
# Destinatario de las notificaciones (contacto y token de visita técnica)
EMAIL_TO=destinatario@ejemplo.com

# ========================================
# FRONTEND
# ========================================
# URL del backend. "/" usa el proxy de nginx del contenedor frontend (recomendado con Docker)
REACT_APP_BASE_URL=/
# Puerto del host para el frontend
FRONTEND_PORT=80





