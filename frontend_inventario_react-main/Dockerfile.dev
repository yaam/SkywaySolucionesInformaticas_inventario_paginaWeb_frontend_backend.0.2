# Dockerfile para desarrollo con hot-reload
FROM node:22-alpine

WORKDIR /app

# Copiar archivos de dependencias
COPY package*.json ./

# Instalar dependencias
RUN npm install --legacy-peer-deps

# Copiar el código fuente
COPY . .

# Exponer puerto 3000
EXPOSE 3000

# Comando de desarrollo con hot-reload
CMD ["npm", "start"]





